# LexAgent talks to any OpenAI-compatible chat API. Leave LLM_API_KEY empty to run in demo mode.
# Copy this file to .env.local and fill in your own key. Never commit .env.local.

# Mistral (default, free "Experiment" plan: https://console.mistral.ai)
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_API_KEY=

# Groq (free tier: https://console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier, prompts may be used for training: https://aistudio.google.com)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Max characters of case text sent to the agents (free tiers limit tokens per minute).
MAX_INPUT_CHARS=40000
